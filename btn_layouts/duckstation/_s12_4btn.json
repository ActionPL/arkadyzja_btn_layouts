// Shared profile: Namco System 12 fighting games with the 4-button Tekken panel.
// source: duckstation-netplay src/core/s12/s12_gamedb.cpp (4btn map): Y=LP X=RP B=LK A=RK, L2=Test Menu, R2=Service Credit.
// Tekken numbering: 1 = LP (Y), 2 = RP (X), 3 = LK (B), 4 = RK (A). Every combination of the four
// buttons is a bind (6 two-button, 4 three-button, 1+2+3+4); defaults only for the four common ones.
// Test/Service deliberately get no default pad input: a stray trigger press mid-match would
// open the operator menu. Bind them yourself in F4 if you need them.
{
  "schema": 1,
  "labels": {
    "Y": "LP", "X": "RP", "B": "LK", "A": "RK",
    "L2": "Test Menu", "R2": "Service Credit",
    "SELECT": "Coin", "START": "Start",
    "UP": "Up", "DOWN": "Down", "LEFT": "Left", "RIGHT": "Right"
  },
  "hide": {
    "L1": true, "R1": true, "L3": true, "R3": true,
    "LS_UP": true, "LS_DOWN": true, "LS_LEFT": true, "LS_RIGHT": true,
    "RS_UP": true, "RS_DOWN": true, "RS_LEFT": true, "RS_RIGHT": true
  },
  // A "binds" section defines the whole set for this layout (the base combos are dropped).
  "binds": {
    "b12":   { "label": "1+2 (LP+RP)",            "buttons": ["Y", "X"] },
    "b34":   { "label": "3+4 (LK+RK)",            "buttons": ["B", "A"] },
    "b13":   { "label": "1+3 (LP+LK) throw",      "buttons": ["Y", "B"] },
    "b24":   { "label": "2+4 (RP+RK) throw",      "buttons": ["X", "A"] },
    "b14":   { "label": "1+4 (LP+RK)",            "buttons": ["Y", "A"] },
    "b23":   { "label": "2+3 (RP+LK)",            "buttons": ["X", "B"] },
    "b123":  { "label": "1+2+3 (LP+RP+LK)",       "buttons": ["Y", "X", "B"] },
    "b124":  { "label": "1+2+4 (LP+RP+RK)",       "buttons": ["Y", "X", "A"] },
    "b134":  { "label": "1+3+4 (LP+LK+RK)",       "buttons": ["Y", "B", "A"] },
    "b234":  { "label": "2+3+4 (RP+LK+RK)",       "buttons": ["X", "B", "A"] },
    "b1234": { "label": "1+2+3+4 (all)",          "buttons": ["Y", "X", "B", "A"] }
  },
  "mapping": {
    "pad":      { "L2": null, "R2": null, "b13": "LB", "b24": "RB", "b12": "LT", "b34": "RT" },
    "keyboard": { "L2": null, "R2": null, "b13": "KEY:U", "b24": "KEY:O", "b12": "KEY:P", "b34": "KEY:;" }
  },
  // Arcade panel on the left/centre, the combos in three rows underneath.
  "button_check": {
    "grid": [12, 10],
    "cells": {
      "L2": [0, 0, 2, 1], "R2": [10, 0, 2, 1],
      "UP": [2, 2], "LEFT": [1, 3], "RIGHT": [3, 3], "DOWN": [2, 4],
      "Y": [6, 2], "X": [8, 2],
      "B": [6, 4], "A": [8, 4],
      "SELECT": [1, 5], "START": [3, 5],
      "b12": [0, 7, 2, 1], "b34": [2, 7, 2, 1], "b13": [4, 7, 2, 1], "b24": [6, 7, 2, 1], "b14": [8, 7, 2, 1], "b23": [10, 7, 2, 1],
      "b123": [0, 8, 3, 1], "b124": [3, 8, 3, 1], "b134": [6, 8, 3, 1], "b234": [9, 8, 3, 1],
      "b1234": [0, 9, 12, 1]
    }
  }
}
