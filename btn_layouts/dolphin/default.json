// retrobuda button layout - Dolphin (GameCube) core.
// source: dolphin Source/Core/DolphinLibretro/Input.cpp descGC: B=B A=A X=X Y=Y, L2/R2 = L/R trigger full press,
// L3/R3 = L/R half press, R=Z, L=Triforce Test, SELECT=Triforce Coin (both hidden: arcade board only),
// left analog = Control Stick, right analog = C Stick. Pad defaults follow Dolphin's own GC-on-Xbox profile.
{
  "schema": 1,
  "name": "GameCube",

  // Every control, in the order the F4 menu lists them. Key = libretro id (B Y SELECT START UP DOWN
  // LEFT RIGHT A X L1 R1 L2 R2 L3 R3) or stick direction (LS_* RS_*); value = the label shown.
  "labels": {
    "UP": "D-Pad Up", "DOWN": "D-Pad Down", "LEFT": "D-Pad Left", "RIGHT": "D-Pad Right", "Y": "Y", "X": "X", "B": "B", "A": "A", "L1": "Triforce Test", "R1": "Z", "L2": "L", "R2": "R", "L3": "L (half press)", "R3": "R (half press)", "SELECT": "Triforce Coin", "START": "Start",
    "LS_UP": "Control Stick Up", "LS_DOWN": "Control Stick Down", "LS_LEFT": "Control Stick Left", "LS_RIGHT": "Control Stick Right", "RS_UP": "C Stick Up", "RS_DOWN": "C Stick Down", "RS_LEFT": "C Stick Left", "RS_RIGHT": "C Stick Right"
  },

  // true = not listed, not drawn, no default input (the game never reads it). A user binding still works.
  "hide": {
    "UP": false, "DOWN": false, "LEFT": false, "RIGHT": false, "Y": false, "X": false, "B": false, "A": false, "L1": true, "R1": false, "L2": false, "R2": false, "L3": false, "R3": false, "SELECT": true, "START": false,
    "LS_UP": false, "LS_DOWN": false, "LS_LEFT": false, "LS_RIGHT": false, "RS_UP": false, "RS_DOWN": false, "RS_LEFT": false, "RS_RIGHT": false
  },

  // Default physical inputs. pad -> slot 1, keyboard -> slot 2 (player 1), keyboard_p2 -> slot 2 of the
  // local player 2 (only with the "Keyboard only" device). Pad names are Xbox positions: A south, B east,
  // X west, Y north, LB RB LT RT LS RS BACK START, DPAD_*, LS_* / RS_* = stick past half deflection.
  // null = no default. Binds are mapped here too, by their key.
  "mapping": {
    "pad": {
      "UP": "DPAD_UP", "DOWN": "DPAD_DOWN", "LEFT": "DPAD_LEFT", "RIGHT": "DPAD_RIGHT", "Y": "Y", "X": "B", "B": "X", "A": "A", "L1": null, "R1": "RB", "L2": "LT", "R2": "RT", "L3": "LB", "R3": "LS", "SELECT": null, "START": "START",
      "LS_UP": "LS_UP", "LS_DOWN": "LS_DOWN", "LS_LEFT": "LS_LEFT", "LS_RIGHT": "LS_RIGHT", "RS_UP": "RS_UP", "RS_DOWN": "RS_DOWN", "RS_LEFT": "RS_LEFT", "RS_RIGHT": "RS_RIGHT",
      "A_B": null, "X_Y": null, "B_Y": null, "A_X": null, "A_Y": null, "B_X": null
    },
    "keyboard": {
      "UP": "KEY:W", "DOWN": "KEY:S", "LEFT": "KEY:A", "RIGHT": "KEY:D", "Y": "KEY:J", "X": "KEY:I", "B": "KEY:K", "A": "KEY:L", "L1": null, "R1": "KEY:O", "L2": "KEY:1", "R2": "KEY:2", "L3": "KEY:Q", "R3": "KEY:3", "SELECT": null, "START": "KEY:Return",
      "LS_UP": "KEY:Up", "LS_DOWN": "KEY:Down", "LS_LEFT": "KEY:Left", "LS_RIGHT": "KEY:Right", "RS_UP": null, "RS_DOWN": null, "RS_LEFT": null, "RS_RIGHT": null,
      "A_B": null, "X_Y": null, "B_Y": null, "A_X": null, "A_Y": null, "B_X": null
    },
    "keyboard_p2": {
      "UP": "KEY:Keypad 8", "DOWN": "KEY:Keypad 2", "LEFT": "KEY:Keypad 4", "RIGHT": "KEY:Keypad 6", "Y": "KEY:Keypad 7", "X": "KEY:Keypad 9", "B": "KEY:Keypad 1", "A": "KEY:Keypad 3", "L1": null, "R1": "KEY:Keypad *", "L2": "KEY:Keypad -", "R2": "KEY:Keypad +", "L3": null, "R3": null, "SELECT": null, "START": "KEY:Keypad Enter",
      "LS_UP": null, "LS_DOWN": null, "LS_LEFT": null, "LS_RIGHT": null, "RS_UP": null, "RS_DOWN": null, "RS_LEFT": null, "RS_RIGHT": null,
      "A_B": null, "X_Y": null, "B_Y": null, "A_X": null, "A_Y": null, "B_X": null
    }
  },

  // One input presses several buttons at once. Key: [A-Za-z0-9_-]{1,32}, max 16 per layout. A file that has a
  // "binds" section defines the whole set (lower layers' binds are dropped, not added); {} = no binds.
  "binds": {
    "A_B": { "label": "A+B", "buttons": ["A", "B"] },
    "X_Y": { "label": "X+Y", "buttons": ["X", "Y"] },
    "B_Y": { "label": "B+Y", "buttons": ["B", "Y"] },
    "A_X": { "label": "A+X", "buttons": ["A", "X"] },
    "A_Y": { "label": "A+Y", "buttons": ["A", "Y"] },
    "B_X": { "label": "B+X", "buttons": ["B", "X"] }
  },

  // Button Check view: [col, row] or [col, row, w, h] on a grid, [0,0] top-left. Replaced wholesale by a
  // higher layer that defines its own grid.
  "button_check": {
    "grid": [12, 10],
    "cells": {
      "L2": [0, 0, 2, 1],
      "R2": [10, 0, 2, 1],
      "R1": [10, 1, 2, 1],
      "START": [7, 2],
      "UP": [1, 3],
      "LEFT": [0, 4],
      "RIGHT": [2, 4],
      "DOWN": [1, 5],
      "X": [9, 3],
      "Y": [8, 4],
      "A": [10, 4],
      "B": [9, 5],
      "L3": [3, 7],
      "LS_UP": [3, 6],
      "LS_LEFT": [2, 7],
      "LS_RIGHT": [4, 7],
      "LS_DOWN": [3, 8],
      "R3": [8, 7],
      "RS_UP": [8, 6],
      "RS_LEFT": [7, 7],
      "RS_RIGHT": [9, 7],
      "RS_DOWN": [8, 8],
      "A_B": [0, 9, 2, 1],
      "X_Y": [2, 9, 2, 1],
      "B_Y": [4, 9, 2, 1],
      "A_X": [6, 9, 2, 1],
      "A_Y": [8, 9, 2, 1],
      "B_X": [10, 9, 2, 1]
    }
  }
}
